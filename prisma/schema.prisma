generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Category {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  items     CollectionItem[]
  createdAt DateTime         @default(now())
}

model CollectionItem {
  id               String   @id @default(cuid())
  name             String
  description      String?
  price            Decimal? @db.Decimal(10, 2)
  imageFileId      String?
  imageFileName    String?
  instagramReelUrl String?
  tiktokReelUrl    String?
  published        Boolean  @default(true)
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Branch {
  id            String  @id @default(cuid())
  name          String
  address       String
  phone         String?
  email         String?
  latitude      Float?
  longitude     Float?
  mapEmbedUrl   String?
  imageFileId   String?
  imageFileName String?
  sortOrder     Int     @default(0)
  published     Boolean @default(true)
}

model Review {
  id         String  @id @default(cuid())
  authorName String
  rating     Int
  content    String
  published  Boolean @default(true)
  sortOrder  Int     @default(0)
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum MediaStorageProvider {
  SUPABASE
  GOOGLE_DRIVE
}

model MediaAsset {
  id              String               @id @default(cuid())
  fileId          String
  fileName        String
  mimeType        String
  mediaType       MediaType
  storageProvider MediaStorageProvider
  altText         String?
  caption         String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  contentEntries  SiteContent[]

  @@unique([storageProvider, fileId])
  @@index([mediaType, createdAt])
}

model SiteContent {
  id           String      @id @default(cuid())
  page         String
  region       String      @default("global")
  section      String
  field        String
  value        String?     @db.Text
  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([page, region, section, field])
  @@index([page, region])
}
